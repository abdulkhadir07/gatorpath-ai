# Set ONE of these. Without a key, GatorPath uses offline fallbacks so the demo still runs.
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Optional: force a provider (gemini | openai | anthropic) or override the model.
# AI_PROVIDER=gemini
# GEMINI_MODEL=gemini-2.5-flash
# OPENAI_MODEL=gpt-4.1-mini
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
